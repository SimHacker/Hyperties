{
  "name": "hyperties-format-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild dist/index.js --bundle --format=iife --global-name=HypertiesFormats --outfile=dist/browser.js",

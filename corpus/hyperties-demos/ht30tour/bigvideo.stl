BACKGROUND
  GROB="silframe.grb"
  TEXTCOLOR = 6
  HIGHLIGHTCOLOR = 3
  CURSORCOLOR = 3
  RETURNTO = GROB "mm2retrn.GRB" AT 263,440 XOR 15
  FONT = "HELVE002"
ENDBACKGROUND
TEXTWINDOW
  SIZE = 540 BY 316 AT 50,46
  TEXTCOLOR = 6
  HIGHLIGHTCOLOR = 3
  CURSORCOLOR = 3
  NEXTPAGE = GROB "SLNXPAGE.GRB" AT 481,440 XOR 15
  BACKPAGE = GROB "SLBKPAGE.GRB" AT 14,440 XOR 15
  FONT = "HELVE002"
ENDTEXTWINDOW
VIDEOWINDOW
  SOURCE = ? BY ? AT 1,1
  SIZE = 690 BY 400 AT 8,28
  PAUSE = NOBOX "Pause" AT 210,412 XOR 6
  PLAY = NOBOX "Play" AT 360,412 XOR 6
  RESTART = NOBOX "Restart" AT 60,412 XOR 6
  STOP = NOBOX "STOP" AT 520,412 XOR 6
  IMAGESIZE = 100
  TRANSPARENTCOLOR = 0
  TEXTCOLOR = 6
ENDVIDEOWINDOW


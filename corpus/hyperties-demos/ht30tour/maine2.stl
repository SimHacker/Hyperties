BACKGROUND
  GROB="MAINE2.grb"
  TEXTCOLOR = 10
  HIGHLIGHTCOLOR = 9
  CURSORCOLOR = 15
  RETURNTO = NOBOX "Return to $PREVIOUSARTICLE" 240 BY ? AT 200,445 XOR 15
  FONT = "HELVE002"
ENDBACKGROUND
TEXTWINDOW
  SIZE = 630 BY 400 AT 5,5
  TEXTCOLOR = 10
  HIGHLIGHTCOLOR = 9
  CURSORCOLOR = 15
  NEXTPAGE = NOBOX "Next Page" AT 535,445 XOR 15
  BACKPAGE = NOBOX "Back Page" AT 16,445 XOR 15
  FONT = "HELVE002"
ENDTEXTWINDOW 


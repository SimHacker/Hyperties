BACKGROUND
  GROB="silvback.grb"
  TEXTCOLOR = 12
  HIGHLIGHTCOLOR = 6
  CURSORCOLOR = 6
  RETURNTO = NOBOX "Return to $PREVIOUSARTICLE" 200 BY ? AT 248,400 XOR 6
  FONT = "HELVE002"
ENDBACKGROUND
TEXTWINDOW
  SIZE = 480 BY 203 AT 68,187
  TEXTCOLOR = 12
  HIGHLIGHTCOLOR = 6
  CURSORCOLOR = 6
  NEXTPAGE = NOBOX "Next Page" AT 460,400 XOR 6
  BACKPAGE = NOBOX "Back Page" AT 68,400 XOR 6
  FONT = "HELVE002"
ENDTEXTWINDOW


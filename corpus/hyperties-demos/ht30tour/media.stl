BACKGROUND
  GROB="vidback.grb"
  TEXTCOLOR = 6
  HIGHLIGHTCOLOR = 3
  CURSORCOLOR = 6
  RETURNTO = GROB "MMURETRN.GRB" AT 263,420 XOR 15
  FONT = "HELVE002"
ENDBACKGROUND
TEXTWINDOW
  SIZE = 210 BY 316 AT 50,46
  TEXTCOLOR = 6
  HIGHLIGHTCOLOR = 3
  CURSORCOLOR = 6
  NEXTPAGE = GROB "SLNXPAGE.GRB" AT 481,420 XOR 15
  BACKPAGE = GROB "SLBKPAGE.GRB" AT 14,420 XOR 15
  FONT = "HELVE002"
ENDTEXTWINDOW
VIDEOWINDOW
  SOURCE = ? BY ? AT 339,48
  SIZE = 338 BY 214 AT 334,64
  PAUSE = NOBOX "Pause" AT 440,310 XOR 6
  PLAY = NOBOX "Play" AT 552,325 XOR 6
  RESTART = NOBOX "Restart" AT 328,325 XOR 6
  STOP = NOBOX "STOP" AT 444,341 XOR 6
  IMAGESIZE = 50
  TRANSPARENTCOLOR = 256
  TEXTCOLOR = 6
ENDVIDEOWINDOW

